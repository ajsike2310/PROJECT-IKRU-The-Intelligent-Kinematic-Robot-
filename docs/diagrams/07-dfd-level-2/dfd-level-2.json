      "width": 130
    },
    {
      "id": "scene",
      "type": "external",
      "label": "3.0 Perceive scene",
      "sublabel": "from Level 1",
      "stage": 0,
      "row": 1,
      "width": 130
    },
    {
      "id": "sonar",
      "type": "external",
      "label": "ProximityMonitor",
      "sublabel": "cached distance",
      "stage": 0,
      "row": 2,
      "width": 130
    },
    {
      "id": "p21",
      "type": "backend",
      "label": "2.1 Screen input",
      "sublabel": "exit phrase, busy",
      "stage": 1,
      "row": 0,
      "width": 130
    },
    {
      "id": "p23",
      "type": "backend",

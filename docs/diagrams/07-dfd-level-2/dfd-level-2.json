{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "IKRU Data Flow Diagram: Level 2 (2.0 Converse)",
    "output": "dfd-level-2.html",
    "quality_profile": "showcase",
    "viewBox": [
      1080,
      540
    ],
    "legend": {
      "entries": {
        "database": {
          "label": "Data store"
        }
      }
    },
    "views": [
      {
        "id": "llm-path",
        "label": "LLM path",
        "focus": [
          "p21",
          "p23",
          "p24",
          "d1",
          "ollama",
          "p25",
          "p26",
          "out"
        ],
        "note": "Screened text gains context and memory, goes to Ollama, and comes back as reply segments and tools."
      },
      {
        "id": "laya-path",
        "label": "Laya path",
        "focus": [
          "p21",
          "p22",
          "p26",
          "out"
        ],
        "note": "In parallel, Laya picks the physical action; its decision wins when confident."
      },
      {
        "id": "context-sources",
        "label": "Context sources",
        "focus": [
          "scene",
          "sonar",
          "text",
          "p23"
        ],
        "note": "Camera text (visual questions only) and the latest sonar reading join the user's words."
      }
    ]
  },
  "stages": [
    {
      "label": "Inputs"
    },
    {
      "label": "Screen + context"
    },
    {
      "label": "Intent + prompt"
    },
    {
      "label": "Interpret"
    },
    {
      "label": "Output"
    }
  ],
  "nodes": [
    {
      "id": "text",

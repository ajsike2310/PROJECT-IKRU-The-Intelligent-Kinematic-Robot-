      "stage": 2,
      "row": 0,
      "width": 130
    },
    {
      "id": "p24",
      "type": "backend",
      "label": "2.4 Query LLM",
      "sublabel": "ChatEngine.ask()",
      "stage": 2,
      "row": 1,
      "width": 130
    },
    {
      "id": "d1",
      "type": "database",
      "label": "D1 Memory",
      "sublabel": "SQLite + Qdrant",
      "stage": 2,
      "row": 2,
      "width": 130
    },
    {
      "id": "p26",
      "type": "backend",
      "label": "2.6 Merge tools",
      "sublabel": "merge_tool_calls()",
      "stage": 3,
      "row": 0,
      "width": 130
    },
    {
      "id": "p25",
      "type": "backend",
      "label": "2.5 Parse reply",
      "sublabel": "JSON + segments",
      "stage": 3,
      "row": 1,
      "width": 130
